{
  "$schema": "https://schemas.runtipi.io/dynamic-compose.json",
  "services": [
    {
      "name": "exepad",
      "image": "ghcr.io/exepad/exepad-app-builder:latest",
      "isMain": true,
      "internalPort": 8080,
      "environment": {
        "EXEPAD_HTTPS_DISABLE": "1",
        "EXEPAD_LLM_API_KEY": "${EXEPAD_LLM_API_KEY}",
        "EXEPAD_LLM_PROVIDER": "${EXEPAD_LLM_PROVIDER}"
      },
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data",
          "containerPath": "/data"
        }
      ]
    }
  ]
}
