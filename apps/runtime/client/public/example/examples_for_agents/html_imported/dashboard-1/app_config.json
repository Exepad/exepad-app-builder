    "handlers": [
      {
        "uuid": "h-getDashboardOverview",
        "name": "getDashboardOverview",
        "method": "getDashboardOverview",
        "authLevel": "authenticated",
        "inputs": [],
        "outputs": [
          {
            "name": "totalHives",
            "type": "number",
            "summary": "Total number of hives"
          },
          {
            "name": "totalYield",
            "type": "number",
            "summary": "Total honey yield in kg this season"
          },
          {
            "name": "activeAlerts",
            "type": "number",
            "summary": "Number of active pest alerts"
          },
          {
            "name": "pendingInspections",
            "type": "number",
            "summary": "Number of inspections not yet completed"
          },
          {
            "name": "honeyTargetPercent",
            "type": "number",
            "summary": "Percentage of season honey target achieved"
          }
        ]
      },
      {
        "uuid": "h-getHiveActivityData",
        "name": "getHiveActivityData",
        "method": "getHiveActivityData",
        "authLevel": "authenticated",
        "inputs": [
          {
            "name": "hive_id",
            "type": "string",
            "required": true,
            "summary": "ID of the hive to get activity data for"
          },
          {
            "name": "hours",
            "type": "number",
            "required": false,
            "summary": "Number of hours of data to return (default 24)"
          }
        ],
        "outputs": [
          {
            "name": "data",
            "type": "array",
            "summary": "Array of {hour, activity} objects for sparkline charts"
          }
        ]
      },
      {
        "uuid": "h-getProductionTrend",
        "name": "getProductionTrend",
        "method": "getProductionTrend",
        "authLevel": "authenticated",
        "inputs": [
          {
            "name": "period",
            "type": "string",
            "required": false,
            "summary": "Time period: 30d, 90d, or yearly (default 30d)"
          }
        ],
        "outputs": [
          {
            "name": "data",
            "type": "array",
            "summary": "Array of {label, volume} objects for area/bar charts"
          },
          {
            "name": "totalYield",
            "type": "number",
            "summary": "Total yield for the period in kg"
          },
          {
            "name": "avgPerHive",
            "type": "number",
            "summary": "Average yield per hive in kg"
          },
          {
            "name": "yoyChange",
            "type": "number",
            "summary": "Year-over-year change percentage"
          }
        ]
      },
      {
        "uuid": "h-getMiteLoadTrend",
        "name": "getMiteLoadTrend",
        "method": "getMiteLoadTrend",
        "authLevel": "authenticated",
        "inputs": [
          {
            "name": "months",
            "type": "number",
            "required": false,
            "summary": "Number of months of data to return (default 6)"
          }
        ],
        "outputs": [
          {
            "name": "data",
            "type": "array",
            "summary": "Array of {month, load} objects for mite load chart"
          },
          {
            "name": "currentLoad",
            "type": "number",
            "summary": "Current overall mite load percentage"
          },
          {
            "name": "momChange",
            "type": "number",
            "summary": "Month-over-month change in mite load"
          },
          {
            "name": "treatmentEfficacy",
            "type": "number",
            "summary": "Treatment efficacy percentage"
          }
        ]
      },
      {
        "uuid": "h-completeInspection",
        "name": "completeInspection",
        "method": "completeInspection",
        "authLevel": "authenticated",
        "inputs": [
          {
            "name": "inspection_id",
            "type": "string",
            "required": true,
            "summary": "ID of the inspection to complete"
          },
          {
            "name": "checklist",
            "type": "json",
            "required": false,
            "summary": "Checklist completion data"
          },
          {
            "name": "notes",
            "type": "string",
            "required": false,
            "summary": "Inspection notes"
          }
        ],
        "outputs": [
          {
            "name": "success",
            "type": "boolean",
            "summary": "Whether the inspection was successfully completed"
          }
        ]
      },
      {
        "uuid": "h-seedDemoData",
        "name": "seedDemoData",
        "method": "seedDemoData",
        "authLevel": "admin",
        "inputs": [],
        "outputs": [
          {
            "name": "seeded",
            "type": "boolean",
            "summary": "Whether demo data was successfully inserted"
          },
          {
            "name": "counts",
            "type": "json",
            "summary": "Number of records inserted per model"
          }
        ]
      }
