        "indexes": [
          {
            "name": "idx_harvest_hive_id",
            "columns": [
              "hive_id"
            ],
            "unique": false
          },
          {
            "name": "idx_harvest_date",
            "columns": [
              "harvested_at"
            ],
            "unique": false
          }
        ],
        "ownerScope": "shared",
        "crudPolicy": {
          "create": "authenticated",
          "read": "authenticated",
          "update": "authenticated",
          "delete": "admin"
        }
      },
      {
        "uuid": "model-pest-alerts",
        "name": "pest_alerts",
        "columns": [
          {
            "name": "hive_id",
            "type": "text",
            "summary": "Reference to hives model ID"
          },
          {
            "name": "pest_type",
            "type": "text",
            "summary": "Type of pest: Varroa Mites, Wax Moth, Small Hive Beetle, etc."
