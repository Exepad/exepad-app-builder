        "crudPolicy": {
          "create": "authenticated",
          "read": "authenticated",
          "update": "authenticated",
          "delete": "admin"
        }
      },
      {
        "uuid": "model-apiary-settings",
        "name": "apiary_settings",
        "columns": [
          {
            "name": "full_name",
            "type": "text",
            "summary": "Beekeeper's full name",
            "isNullable": true
