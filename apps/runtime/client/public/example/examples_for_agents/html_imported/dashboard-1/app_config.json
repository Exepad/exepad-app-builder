          {
            "name": "severity",
            "type": "text",
            "summary": "Alert severity: low, medium, high, or critical"
          },
          {
            "name": "varroa_count",
            "type": "real",
            "summary": "Phoretic mite percentage, e.g. 3.4",
            "isNullable": true
          },
          {
            "name": "status",
            "type": "text",
