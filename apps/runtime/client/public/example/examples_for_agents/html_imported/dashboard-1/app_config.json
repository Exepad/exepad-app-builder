{
  "uuid": "apiary-insight",
  "alias": "apiary-insight",
  "name": "The Living Ledger",
  "appType": "WebAppProps",
  "appSecondaryType": "dataapp",
  "version": "1.0.0",
  "summary": "Beekeeping management dashboard with hive monitoring, honey production tracking, and pest control",
  "shortSummary": "Apiary management dashboard",
  "lastUpdatedEpoch": 1742515200,
  "security": {
    "authProviders": [
      {
        "provider": "email"
      }
    ],
    "sessionDuration": 604800,
    "allowSignup": true
  },
  "repo": {
    "frontend": {
      "components": {
        "DashboardSidebar": {
          "source": "frontend/code/components/DashboardSidebar.tsx",
          "compiled": "frontend/compiled/components/DashboardSidebar.js",
          "summary": "Fixed left sidebar with route-aware navigation: Overview, Hives, Honey Production, Pest Control, Settings. Includes app logo, status badge, Add Inspection CTA, Help/Logout links."
        },
        "OverviewContent": {
          "source": "frontend/code/components/OverviewContent.tsx",
          "compiled": "frontend/compiled/components/OverviewContent.js",
          "summary": "Dashboard overview: KPI cards (total hives, honey yield, active alerts, inspections due), recent activity, hive health chart, upcoming tasks"
        },
        "HivesContent": {
          "source": "frontend/code/components/HivesContent.tsx",
          "compiled": "frontend/compiled/components/HivesContent.js",
          "summary": "Hives grid: colony cards with health status, queen age, population indicators, filter/sort controls"
        },
        "HoneyContent": {
          "source": "frontend/code/components/HoneyContent.tsx",
          "compiled": "frontend/compiled/components/HoneyContent.js",
          "summary": "Honey production: yield metrics, harvest timeline, quality grades, storage inventory"
        },
        "PestControlContent": {
          "source": "frontend/code/components/PestControlContent.tsx",
          "compiled": "frontend/compiled/components/PestControlContent.js",
          "summary": "Pest control monitoring: varroa mite counts, treatment schedule, alert log, inspection checklist"
        },
        "SettingsContent": {
          "source": "frontend/code/components/SettingsContent.tsx",
          "compiled": "frontend/compiled/components/SettingsContent.js",
          "summary": "Settings: apiary profile, notification preferences, team management, data export"
        }
      },
      "styles": {
        "theme": {
          "source": "frontend/code/styles/theme.css",
          "compiled": "frontend/compiled/styles/theme.css",
          "summary": "Material Symbols icon font class, base typography, Shadow DOM :host styles"
        }
      },
      "fonts": [
        "https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap",
        "https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&family=Inter:wght@400;500;600&display=swap"
      ]
    },
    "backend": {
      "handlers": {}
    }
  },
  "backend": {
    "mode": "dynamic",
    "models": [
      {
        "uuid": "model-hives",
        "name": "hives",
        "columns": [
          {
            "name": "name",
            "type": "text",
            "summary": "Hive display name, e.g. Hive Alpha, Hive Beta"
          },
          {
            "name": "location",
            "type": "text",
            "summary": "Position within the apiary",
            "isNullable": true
          },
          {
            "name": "status",
            "type": "text",
            "summary": "Health status: Thriving, Monitoring, or Alert",
            "defaultValue": "Thriving"
          },
          {
            "name": "queen_name",
            "type": "text",
            "summary": "Name of the queen bee, e.g. Isabella II",
            "isNullable": true
          },
          {
            "name": "queen_marking_color",
            "type": "text",
            "summary": "Queen marking color, e.g. Blue, White, Yellow",
            "isNullable": true
          },
          {
            "name": "temperature",
            "type": "real",
            "summary": "Current hive temperature in Celsius",
            "isNullable": true
          },
          {
            "name": "humidity",
            "type": "integer",
            "summary": "Current humidity percentage (0-100)",
            "isNullable": true
          },
          {
            "name": "activity_change",
            "type": "integer",
            "summary": "24-hour activity change percentage, e.g. +12 or -24",
            "isNullable": true
          },
          {
            "name": "population_density",
            "type": "integer",
            "summary": "Population density percentage (0-100)",
            "isNullable": true
          },
          {
            "name": "sound_status",
            "type": "text",
            "summary": "Acoustic status: Steady or Irregular",
            "isNullable": true
          },
          {
            "name": "installed_at",
            "type": "text",
            "summary": "ISO 8601 date when hive was installed",
            "isNullable": true
          }
        ],
        "indexes": [
          {
            "name": "idx_hives_status",
            "columns": [
              "status"
            ],
            "unique": false
          },
          {
            "name": "idx_hives_name",
            "columns": [
              "name"
            ],
            "unique": true
          }
        ],
        "ownerScope": "shared",
        "crudPolicy": {
          "create": "authenticated",
          "read": "authenticated",
          "update": "authenticated",
          "delete": "admin"
        }
      },
      {
        "uuid": "model-sensor-readings",
        "name": "sensor_readings",
        "columns": [
          {
            "name": "hive_id",
            "type": "text",
            "summary": "Reference to hives model ID"
          },
          {
            "name": "temperature",
            "type": "real",
            "summary": "Temperature reading in Celsius",
            "isNullable": true
          },
          {
            "name": "humidity",
            "type": "integer",
            "summary": "Humidity percentage (0-100)",
            "isNullable": true
          },
          {
            "name": "activity_level",
            "type": "integer",
            "summary": "Activity level on 0-100 scale",
            "isNullable": true
          },
          {
            "name": "recorded_at",
            "type": "text",
            "summary": "ISO 8601 timestamp of the reading"
          }
        ],
        "indexes": [
          {
            "name": "idx_sensor_hive_id",
            "columns": [
              "hive_id"
            ],
            "unique": false
          },
          {
            "name": "idx_sensor_recorded_at",
            "columns": [
              "recorded_at"
            ],
            "unique": false
          }
        ],
        "ownerScope": "shared",
        "crudPolicy": {
          "create": "authenticated",
          "read": "authenticated",
          "update": "admin",
          "delete": "admin"
        }
      },
      {
        "uuid": "model-harvest-logs",
        "name": "harvest_logs",
        "columns": [
          {
            "name": "hive_id",
            "type": "text",
            "summary": "Reference to hives model ID or hive code like #A-214"
          },
          {
            "name": "quantity_kg",
            "type": "real",
            "summary": "Harvest quantity in kilograms"
          },
          {
            "name": "quality_grade",
            "type": "text",
            "summary": "Quality grade: Grade A+, Grade A, or Grade B"
          },
          {
            "name": "collector",
            "type": "text",
