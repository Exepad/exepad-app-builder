          },
          {
            "name": "email",
            "type": "text",
            "summary": "Contact email address",
            "isNullable": true
          },
          {
            "name": "location",
            "type": "text",
            "summary": "Apiary location, e.g. Cotswolds, UK",
            "isNullable": true
          },
          {
            "name": "active_hives_count",
            "type": "integer",
            "summary": "Number of active hives",
            "isNullable": true
          },
          {
            "name": "flora_type",
            "type": "text",
            "summary": "Primary flora: Mixed Wildflower, Lavender, Heather, or Clover",
