            "defaultValue": "active"
          },
          {
            "name": "detected_at",
            "type": "text",
            "summary": "ISO 8601 timestamp when pest was detected"
          },
          {
            "name": "resolved_at",
            "type": "text",
            "summary": "ISO 8601 timestamp when alert was resolved",
            "isNullable": true
          }
        ],
        "indexes": [
          {
            "name": "idx_pest_status",
            "columns": [
              "status"
            ],
            "unique": false
          },
          {
            "name": "idx_pest_hive_id",
            "columns": [
              "hive_id"
            ],
            "unique": false
          },
          {
            "name": "idx_pest_severity",
            "columns": [
              "severity"
            ],
            "unique": false
          }
        ],
        "ownerScope": "shared",
        "crudPolicy": {
          "create": "authenticated",
          "read": "authenticated",
          "update": "authenticated",
          "delete": "admin"
        }
      },
      {
