          },
          {
            "name": "status",
            "type": "text",
            "summary": "Treatment status: Success, In Progress, or Failed",
            "defaultValue": "In Progress"
          },
          {
            "name": "applied_at",
            "type": "text",
            "summary": "ISO 8601 timestamp when treatment was applied"
          },
          {
            "name": "notes",
            "type": "text",
            "summary": "Additional notes about the treatment",
            "isNullable": true
          }
        ],
        "indexes": [
          {
            "name": "idx_treatment_hive_id",
            "columns": [
              "hive_id"
            ],
            "unique": false
          },
          {
            "name": "idx_treatment_status",
            "columns": [
              "status"
            ],
            "unique": false
          }
        ],
        "ownerScope": "shared",
        "crudPolicy": {
          "create": "authenticated",
          "read": "authenticated",
          "update": "authenticated",
          "delete": "admin"
        }
      },
      {
        "uuid": "model-inspections",
        "name": "inspections",
        "columns": [
          {
            "name": "hive_id",
            "type": "text",
            "summary": "Reference to hives model ID"
          },
          {
            "name": "inspector_name",
            "type": "text",
            "summary": "Name of the inspector",
            "isNullable": true
          },
          {
            "name": "inspection_type",
            "type": "text",
            "summary": "Type: routine, emergency, or seasonal",
