  "backend": {
    "mode": "dynamic",
    "models": [
      {
        "uuid": "model-submissions",
        "name": "submissions",
        "summary": "Form submissions from all form types",
        "ownerScope": "user",
        "columns": [
          {
            "name": "form_type",
            "type": "text",
            "summary": "Type of form: contact, registration, or feedback"
          },
          {
            "name": "data",
            "type": "text",
            "summary": "JSON string containing the form field values"
          },
          {
            "name": "status",
            "type": "text",
            "summary": "Submission status: pending, reviewed, or archived",
            "defaultValue": "pending"
          },
          {
            "name": "submitted_by",
            "type": "text",
            "summary": "Email or name of the person who submitted the form"
          },
          {
            "name": "notes",
            "type": "text",
            "summary": "Admin notes about the submission",
            "isNullable": true
          }
        ],
        "indexes": [
          {
            "name": "idx_submissions_form_type",
            "columns": [
              "form_type"
            ],
            "unique": false
          },
          {
            "name": "idx_submissions_status",
            "columns": [
              "status"
            ],
            "unique": false
          }
        ],
        "crudPolicy": {
          "create": "authenticated",
          "read": "authenticated",
          "update": "admin",
          "delete": "admin"
        }
      },
      {
        "uuid": "model-form-templates",
        "name": "form_templates",
        "summary": "Reusable form template definitions with field configurations",
        "ownerScope": "shared",
        "columns": [
          {
            "name": "name",
            "type": "text",
            "summary": "Template name, e.g. Contact Form, Registration Form"
          },
          {
            "name": "description",
            "type": "text",
            "summary": "Description of the form template purpose"
          },
          {
            "name": "fields",
            "type": "text",
            "summary": "JSON string defining the form fields and their types"
          },
          {
            "name": "is_active",
            "type": "integer",
            "summary": "Whether the template is active (1) or disabled (0)",
            "defaultValue": "1"
          },
          {
            "name": "category",
            "type": "text",
            "summary": "Template category: contact, registration, feedback, survey"
          }
        ],
        "indexes": [
          {
            "name": "idx_form_templates_category",
            "columns": [
              "category"
            ],
            "unique": false
          }
        ],
        "crudPolicy": {
          "create": "admin",
          "read": "public",
          "update": "admin",
          "delete": "admin"
        }
      }
    ],
    "handlers": []
  },
