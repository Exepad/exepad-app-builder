  "appType": "WebAppProps",
  "appSecondaryType": "dataapp",
  "version": "1.0.0",
  "summary": "Form submission and management application with contact, registration, and feedback forms, submission tracking, filtering, and status management",
  "shortSummary": "Form builder with submissions, templates, and management",
  "lastUpdatedEpoch": 1742515200,
  "security": {
    "authProviders": [
      {
        "provider": "email"
      }
    ],
    "sessionDuration": 604800,
    "allowSignup": true,
    "defaultAccess": "public"
  },
  "repo": {
    "frontend": {
      "components": {
        "FormHeader": {
          "source": "frontend/code/components/FormHeader.tsx",
          "compiled": "frontend/compiled/components/FormHeader.js",
          "summary": "Top header bar with FormFlow logo (FileText icon), app name, green accent, user avatar area"
        },
        "FormSidebar": {
          "source": "frontend/code/components/FormSidebar.tsx",
          "compiled": "frontend/compiled/components/FormSidebar.js",
          "summary": "Left sidebar with nav: Dashboard, Contact Form, Registration, Feedback, Submissions. Active state highlighting with icons"
        },
        "FormHome": {
          "source": "frontend/code/components/FormHome.tsx",
          "compiled": "frontend/compiled/components/FormHome.js",
          "summary": "Dashboard with submission stats cards (Total, Pending, Reviewed, Today), recent submissions table, quick action buttons"
        },
        "ContactForm": {
          "source": "frontend/code/components/ContactForm.tsx",
          "compiled": "frontend/compiled/components/ContactForm.js",
          "summary": "Contact form with Full Name, Email, Phone, Subject select, Message textarea, Priority select, validation and submit"
        },
        "RegistrationForm": {
          "source": "frontend/code/components/RegistrationForm.tsx",
          "compiled": "frontend/compiled/components/RegistrationForm.js",
          "summary": "Event registration form with name fields, email, company, job title, dietary preferences, t-shirt size, session preferences"
        },
        "FeedbackForm": {
          "source": "frontend/code/components/FeedbackForm.tsx",
          "compiled": "frontend/compiled/components/FeedbackForm.js",
          "summary": "Feedback form with star rating, category select, like/improve textareas, recommend yes/no buttons, submit"
        },
        "SubmissionsList": {
          "source": "frontend/code/components/SubmissionsList.tsx",
          "compiled": "frontend/compiled/components/SubmissionsList.js",
          "summary": "Submissions table with ID, type badge, submitted by, date, status badge, actions. Filter bar with type/status/search. Pagination"
        },
        "LoginForm": {
          "source": "frontend/code/components/LoginForm.tsx",
          "compiled": "frontend/compiled/components/LoginForm.js",
          "summary": "Login/signup form with email/password, test credential buttons, and returnUrl redirect"
        },
        "ProfilePage": {
          "source": "frontend/code/components/ProfilePage.tsx",
          "compiled": "frontend/compiled/components/ProfilePage.js",
          "summary": "User profile page with avatar, form management stats, performance metrics, and recent activity feed"
        },
        "SettingsPage": {
          "source": "frontend/code/components/SettingsPage.tsx",
          "compiled": "frontend/compiled/components/SettingsPage.js",
          "summary": "Settings page with account info, notification preferences, and sign out"
        }
      },
      "styles": {
        "theme": {
          "source": "frontend/code/styles/theme.css",
          "compiled": "frontend/compiled/styles/theme.css",
          "summary": "Inter font family, form card transitions, star rating styles, status badge animations, submission row hover"
        }
      }
    },
    "backend": {
      "handlers": {}
