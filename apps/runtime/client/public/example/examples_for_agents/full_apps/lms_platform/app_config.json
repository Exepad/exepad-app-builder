          "source": "frontend/code/components/CoursesCatalog.tsx",
          "compiled": "frontend/compiled/components/CoursesCatalog.js",
          "summary": "Course catalog with category tabs, level filter, and grid of course cards with thumbnail, title, instructor, rating, duration, level badge, price, and enroll button."
        },
        "CourseDetail": {
          "source": "frontend/code/components/CourseDetail.tsx",
          "compiled": "frontend/compiled/components/CourseDetail.js",
          "summary": "Single course view with header info, enroll/continue button, curriculum accordion with modules and lessons, and reviews section."
        },
        "LessonViewer": {
          "source": "frontend/code/components/LessonViewer.tsx",
          "compiled": "frontend/compiled/components/LessonViewer.js",
          "summary": "Lesson viewer with video placeholder, lesson content, previous/next navigation, mark as complete button, and lesson sidebar."
        },
        "StudentProgress": {
          "source": "frontend/code/components/StudentProgress.tsx",
          "compiled": "frontend/compiled/components/StudentProgress.js",
          "summary": "Student progress dashboard with overall stats, per-course progress cards, learning streak chart, and certificates earned."
        },
        "QuizPage": {
          "source": "frontend/code/components/QuizPage.tsx",
          "compiled": "frontend/compiled/components/QuizPage.js",
          "summary": "Quiz interface with multiple choice questions, timer, submit button, and results view with score and explanations."
        },
