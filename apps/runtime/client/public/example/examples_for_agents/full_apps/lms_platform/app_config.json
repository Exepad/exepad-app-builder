          "source": "frontend/code/components/LmsDashboard.tsx",
          "compiled": "frontend/compiled/components/LmsDashboard.js",
          "summary": "Dashboard with welcome card, continue learning section, KPI stats (enrolled, completed, hours, certificates), upcoming deadlines, and achievement badges."
        },
