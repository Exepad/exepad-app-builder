  "repo": {
    "frontend": {
      "components": {
        "EventHeader": {
          "source": "frontend/code/components/EventHeader.tsx",
          "compiled": "frontend/compiled/components/EventHeader.js",
          "summary": "Fixed top header with EventSpark logo (Sparkles icon), nav links (Home, Events, Calendar, My Tickets), Create Event CTA button, user menu, backdrop-blur glass effect, pink accent"
        },
        "EventFooter": {
          "source": "frontend/code/components/EventFooter.tsx",
          "compiled": "frontend/compiled/components/EventFooter.js",
          "summary": "4-column footer with About, Categories, Support, Connect sections, newsletter signup input, social icons row, copyright"
        },
        "EventHome": {
          "source": "frontend/code/components/EventHome.tsx",
          "compiled": "frontend/compiled/components/EventHome.js",
          "summary": "Home page: hero with search and category dropdown, featured events carousel (3 large cards), category icons grid (6 categories), upcoming events section (4 cards), stats bar"
        },
        "EventsList": {
          "source": "frontend/code/components/EventsList.tsx",
          "compiled": "frontend/compiled/components/EventsList.js",
          "summary": "Events listing: filter bar with category select, date range inputs, search, sort options, event cards grid with image placeholder, date badge, title, venue, price range, category badge, Get Tickets button, 15+ demo events, pagination"
        },
        "EventDetail": {
          "source": "frontend/code/components/EventDetail.tsx",
          "compiled": "frontend/compiled/components/EventDetail.js",
          "summary": "Single event detail: banner with gradient, title, date/time, venue, address, organizer, description, schedule section, speakers grid (3 speakers), ticket tiers table (3 tiers) with Buy button, venue info"
        },
        "EventCalendar": {
          "source": "frontend/code/components/EventCalendar.tsx",
          "compiled": "frontend/compiled/components/EventCalendar.js",
          "summary": "Monthly calendar grid (7x5/6), colored dots for events, click day to see events in side panel, month navigation, today highlight, mini event list for selected day"
        },
        "MyTickets": {
          "source": "frontend/code/components/MyTickets.tsx",
          "compiled": "frontend/compiled/components/MyTickets.js",
          "summary": "Ticket management: upcoming vs past tabs, ticket cards with event title, date, venue, tier, ticket code (EVT-2024-XXXX format), status badge, QR code placeholder, Download PDF button"
        },
        "LoginForm": {
          "source": "frontend/code/components/LoginForm.tsx",
          "compiled": "frontend/compiled/components/LoginForm.js",
          "summary": "Login/signup form with email/password, test credential buttons, and returnUrl redirect"
        },
        "ProfilePage": {
          "source": "frontend/code/components/ProfilePage.tsx",
          "compiled": "frontend/compiled/components/ProfilePage.js",
          "summary": "User profile page with avatar, event attendance stats, booking highlights, and recent activity feed"
        },
