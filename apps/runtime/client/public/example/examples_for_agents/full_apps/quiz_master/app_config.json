            "name": "quiz_id",
            "type": "integer",
            "summary": "FK to quizzes",
            "references": {
              "model": "quizzes",
              "column": "id",
              "onDelete": "cascade"
            }
          },
          {
            "name": "question_text",
            "type": "text",
            "summary": "The question text"
          },
          {
            "name": "options",
            "type": "text",
            "summary": "JSON array of 4 answer options"
          },
          {
            "name": "correct_answer",
            "type": "integer",
            "summary": "0-based index of the correct answer"
          },
          {
            "name": "explanation",
            "type": "text",
            "summary": "Explanation of the correct answer",
            "isNullable": true
          }
        ],
        "indexes": [
          {
            "name": "idx_questions_quiz",
            "columns": [
              "quiz_id"
            ],
            "unique": false
