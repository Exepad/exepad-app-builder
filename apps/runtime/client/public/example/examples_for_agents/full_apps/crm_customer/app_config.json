          {
            "name": "entity_type",
            "type": "text",
            "summary": "Entity type: contact, deal, or company"
          },
          {
            "name": "entity_id",
            "type": "integer",
            "summary": "ID of the tagged entity"
          }
        ]
      }
    ],
    "handlers": [
      {
        "uuid": "handler-deals-by-stage",
        "name": "getDealsByStage",
        "summary": "Returns all deals for a given pipeline stage with total value",
        "authLevel": "public",
        "handlerType": "read",
        "method": "getDealsByStage",
        "inputs": [
          {
            "name": "stage",
            "type": "string",
            "required": true,
            "summary": "Pipeline stage to filter by"
          }
        ],
        "outputs": [
          {
            "name": "deals",
            "type": "array",
            "items": "json",
            "summary": "Deals in the given stage"
          },
          {
            "name": "total_value",
            "type": "number",
            "summary": "Sum of deal values in this stage"
          }
        ]
      },
      {
        "uuid": "handler-contact-deals",
        "name": "getContactDeals",
        "summary": "Returns all deals and activities for a specific contact",
        "authLevel": "public",
        "handlerType": "read",
        "method": "getContactDeals",
        "inputs": [
          {
            "name": "contact_id",
            "type": "number",
            "required": true,
            "summary": "Contact ID to look up"
          }
        ],
        "outputs": [
          {
            "name": "deals",
            "type": "array",
            "items": "json",
            "summary": "Deals associated with the contact"
          },
          {
            "name": "activities",
            "type": "array",
            "items": "json",
            "summary": "Activities associated with the contact"
          }
        ]
      },
      {
        "uuid": "handler-pipeline-stats",
        "name": "getPipelineStats",
        "summary": "Returns pipeline statistics including per-stage breakdown, total revenue, conversion rate, and average deal size",
        "authLevel": "public",
        "handlerType": "read",
        "method": "getPipelineStats",
        "inputs": [],
        "outputs": [
          {
            "name": "by_stage",
            "type": "array",
            "items": "json",
            "summary": "Deal count and value per stage"
          },
          {
            "name": "total_revenue",
            "type": "number",
            "summary": "Total revenue from closed-won deals"
          },
          {
            "name": "conversion_rate",
            "type": "number",
            "summary": "Percentage of deals that closed won"
          },
          {
            "name": "avg_deal_size",
            "type": "number",
            "summary": "Average value of all deals"
          }
        ]
      }
    ]
  },
