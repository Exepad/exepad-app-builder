      {
        "uuid": "model-contacts",
        "name": "contacts",
        "summary": "Customer and lead contact records",
        "ownerScope": "shared",
        "columns": [
          {
            "name": "name",
            "type": "text",
            "summary": "Full name of the contact"
          },
          {
            "name": "email",
            "type": "text",
            "summary": "Email address",
            "isUnique": true
          },
          {
            "name": "company",
            "type": "text",
            "summary": "Company name"
          },
          {
            "name": "phone",
            "type": "text",
            "summary": "Phone number",
            "isNullable": true
          },
          {
            "name": "status",
            "type": "text",
            "summary": "Contact status: lead, prospect, customer, or churned"
          },
          {
            "name": "notes",
            "type": "text",
            "summary": "Free-text notes about the contact",
            "isNullable": true
          },
          {
            "name": "created_at",
            "type": "text",
            "summary": "ISO date when contact was created"
          }
        ]
      },
      {
        "uuid": "model-deals",
        "name": "deals",
        "summary": "Sales deals and opportunities",
        "ownerScope": "shared",
        "columns": [
          {
            "name": "name",
            "type": "text",
            "summary": "Deal name or title"
          },
          {
            "name": "company",
            "type": "text",
            "summary": "Company associated with the deal"
          },
          {
            "name": "value",
            "type": "real",
            "summary": "Monetary value of the deal"
          },
          {
            "name": "stage",
            "type": "text",
            "summary": "Pipeline stage: qualification, proposal, negotiation, closed_won, closed_lost"
          },
          {
            "name": "close_date",
            "type": "text",
            "summary": "Expected or actual close date"
          },
          {
            "name": "contact_id",
            "type": "integer",
            "summary": "FK to contacts table",
            "references": {
              "model": "contacts",
              "column": "id",
              "onDelete": "cascade"
            }
          }
        ]
      },
      {
        "uuid": "model-activities",
        "name": "activities",
        "summary": "CRM activity log for calls, emails, meetings, and notes",
        "ownerScope": "shared",
        "columns": [
          {
            "name": "type",
            "type": "text",
            "summary": "Activity type: call, email, meeting, or note"
          },
          {
            "name": "subject",
            "type": "text",
            "summary": "Activity subject line"
          },
          {
            "name": "description",
            "type": "text",
            "summary": "Detailed description of the activity"
          },
          {
            "name": "contact_id",
            "type": "integer",
            "summary": "FK to contacts table",
            "references": {
              "model": "contacts",
              "column": "id",
              "onDelete": "cascade"
            }
          },
          {
            "name": "deal_id",
            "type": "integer",
            "summary": "FK to deals table (optional)",
            "isNullable": true,
            "references": {
              "model": "deals",
              "column": "id",
              "onDelete": "set_null"
            }
          },
          {
            "name": "date",
            "type": "text",
            "summary": "ISO date/time of the activity"
          }
        ]
      },
      {
        "uuid": "model-companies",
        "name": "companies",
        "summary": "Company directory with firmographic data",
        "ownerScope": "shared",
        "columns": [
          {
            "name": "name",
            "type": "text",
            "summary": "Company name",
            "isUnique": true
          },
          {
            "name": "industry",
            "type": "text",
            "summary": "Industry vertical"
          },
          {
            "name": "website",
            "type": "text",
            "summary": "Company website URL",
            "isNullable": true
          },
          {
            "name": "size",
            "type": "text",
            "summary": "Employee count range: 1-10, 11-50, 51-200, 201-1000, 1000+"
          },
          {
            "name": "revenue",
            "type": "real",
            "summary": "Annual revenue estimate"
          }
        ]
      },
      {
        "uuid": "model-tags",
        "name": "tags",
        "summary": "Tags for contacts, deals, and companies",
        "ownerScope": "shared",
        "columns": [
          {
            "name": "name",
            "type": "text",
            "summary": "Tag label"
          },
          {
            "name": "color",
            "type": "text",
            "summary": "Tag color (hex)"
