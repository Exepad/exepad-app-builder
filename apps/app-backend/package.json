{
  "name": "@exepad/app-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts"
    },
    "./auth/utils": {
      "types": "./dist/auth/utils.d.ts",
      "import": "./src/auth/utils.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@exepad/types": "workspace:*",
    "esbuild": "^0.27.2",
    "undici": "^7.16.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "@exepad/deploy-utils": "workspace:*",
    "@exepad/local-adapters": "workspace:*",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.0.18",
    "better-sqlite3": "^11.8.1",
    "tsx": "^4.7.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.4"
  },
  "license": "AGPL-3.0-only"
}
