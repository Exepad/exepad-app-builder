# Environment Configuration Example
# Copy this file to .env and update with your actual values

# ==============================================================================
# AGENT MODEL CONFIGURATION (OPTIONAL OVERRIDES)
# ==============================================================================
# These keys override the defaults in config.py. If omitted, the agent uses the
# built-in default model for each agent.

# Core agents
APP_HELP_DESK_MODEL="gemini-3-flash-preview"
CREATOR_MODEL="gemini-3-flash-preview"
# Editor is the planner-side reasoning seat (cross-domain orchestration);
# default is the pro tier. Override to flash for cost / latency rollback.
EDITOR_MODEL="gemini-3.1-pro-preview"
BLOG_POST_CREATOR_MODEL="gemini-3-flash-preview"

# Build pipeline
COMPONENT_BUILDER_MODEL="gemini-3-flash-preview"
# ComponentBuilderMultiple is the multi-file refactor worker (12-tool
# coding-agent surface). Default is the pro tier — autonomous file
# discovery + cross-file edits benefit materially from reasoning capacity.
COMPONENT_BUILDER_MULTIPLE_MODEL="gemini-3.1-pro-preview"
# Tool-call caps. Standard dispatch (user edits) keeps the 25 budget that
# fits a single-file refactor. Design-import polish dispatch processes
# 4-6 components per turn with multiple edits per component, so it gets a
# higher budget (45 covers the empirical p99 from rdzn62gx-class apps).
# COMPONENT_BUILDER_MULTIPLE_MAX_TOOL_CALLS=25
# COMPONENT_BUILDER_MULTIPLE_POLISH_MAX_TOOL_CALLS=45
DESIGN_SYSTEM_BUILDER_MODEL="gemini-3-flash-preview"
LOGIC_BUILDER_MODEL="gemini-3-flash-preview"
BACKEND_MODEL_BUILDER_MODEL="gemini-3-flash-preview"
BACKEND_HANDLER_BUILDER_MODEL="gemini-3-flash-preview"
SEED_DATA_BUILDER_MODEL="gemini-3-flash-preview"
FIXER_MODEL="gemini-3-flash-preview"

# Support agents
RESULT_RESPONSE_WRITER_MODEL="gemini-3-flash-preview"
SKILL_SELECTOR_MODEL="gemini-3-flash-preview"
PRE_CREATOR_MODEL="gemini-3-flash-preview"
DESIGN_IMPORTER_MODEL="gemini-3-flash-preview"

# ==============================================================================
# LLM PROVIDER (self-host: any vendor via LiteLLM)
# ==============================================================================
# EXEPAD_LLM_PROVIDER selects the backend for every agent (see config.get_agent_model):
#   gemini (default) | vertex  -> native ADK Gemini (uses GEMINI_API_KEY / Vertex)
#   anthropic | openai | openrouter | ollama | groq | mistral | deepseek
#   custom | openai-compatible  -> any OpenAI-compatible endpoint (set EXEPAD_LLM_BASE_URL)
# EXEPAD_LLM_PROVIDER="anthropic"
#
# API key for the selected non-Gemini provider (LiteLLM also reads vendor-native
# vars like ANTHROPIC_API_KEY / OPENAI_API_KEY if you prefer those):
# EXEPAD_LLM_API_KEY="sk-..."
#
# Base URL for OpenAI-compatible / self-hosted endpoints (OpenRouter, Ollama,
# vLLM, LM Studio, a corporate gateway, …):
# EXEPAD_LLM_BASE_URL="http://localhost:11434/v1"
#
# Default model used when a non-Gemini provider is selected but a given agent's
# model is still a gemini-* default (i.e. you didn't set its {AGENT}_MODEL):
# EXEPAD_LLM_MODEL_DEFAULT="claude-sonnet-4-5"
# (Per-agent {AGENT}_MODEL overrides still win; values already containing a "/"
#  are passed to LiteLLM verbatim, e.g. CREATOR_MODEL="openrouter/anthropic/claude-3.5-sonnet")
#
# Cost attribution for non-Gemini models: by default the metrics summary prices
# OpenRouter/LiteLLM runs from a live catalog pulled once from
# https://openrouter.ai/api/v1/models (public, no key needed), falling back to a
# built-in static table. Set to "false" to use only the static table (no network).
# OPENROUTER_PRICING_LIVE="true"
# OPENROUTER_PRICING_TIMEOUT="4"   # seconds; one fetch per process, fail-open

# ==============================================================================
# CONTENT HANDLING CONFIGURATION (OPTIONAL - defaults shown)
# ==============================================================================

# Document artifact settings
# Documents larger than this will use Vertex AI Search instead of artifacts
# DOCUMENT_MAX_SIZE_CHARS=50000

# Image catalog summary settings
# Maximum number of images to include in the summary for planner agents
# IMAGE_CATALOG_SUMMARY_LIMIT=10
# Maximum length of image descriptions in the summary (characters)
# IMAGE_DESCRIPTION_MAX_LENGTH=60

# Document fetch retry settings (for fetching documents from content_url)
# DOCUMENT_FETCH_MAX_RETRIES=3
# DOCUMENT_FETCH_INITIAL_DELAY=1.0
# DOCUMENT_FETCH_BACKOFF_MULTIPLIER=2.0
# DOCUMENT_FETCH_TIMEOUT=30

# Skip document fetching (for E2E tests with mock catalog URLs)
# When true, _fetch_and_save_document saves mock content instead of making HTTP requests
# SKIP_DOCUMENT_FETCH=false

# ==============================================================================
# OTHER CONFIGURATION (Add your other env vars here)
# ==============================================================================

# Example:
# DJANGO_BACKEND_URL="https://your-backend.example.com"
# AGENT_SERVICE_API_KEY="your-api-key-here"
# JWT_SECRET_KEY="your-secret-key-here"
# Stock images: exactly ONE provider is active at a time (set in the Settings
# UI, which is authoritative and clears the others). Openverse is keyless (the
# default, and always the silent last-resort fallback); the keyed providers
# below are FREE (free API key, commercial-use license).
# IMAGE_PROVIDER="openverse"           # Active provider: "openverse" | "pexels" | "pixabay" | "unsplash"
# PEXELS_API_KEY="your-pexels-api-key"          # pexels.com/api
# PIXABAY_API_KEY="your-pixabay-api-key"        # pixabay.com/api/docs
# UNSPLASH_API_KEY="your-unsplash-access-key"   # Unsplash Access Key (search + download ping)
# ALLOWED_IMAGE_DOMAINS=""             # Extra image hosts to KEEP (comma/space separated)
#
# With Openverse selected (or no keyed provider set), the agent KEEPS any
# working image URLs the model produced and fills genuine placeholders with
# keyless Openverse (Creative-Commons) search results, falling back to
# deterministic Lorem Picsum images (picsum.photos) — instead of replacing
# everything with a gray box. Openverse needs no API key.
# GOOGLE_CLOUD_PROJECT="your-project-id"
# GOOGLE_CLOUD_LOCATION="global"
# GOOGLE_GENAI_USE_VERTEXAI="True"

# ==============================================================================
# SURVEYOR PHASE 2 — RUNTIME PROBES
# ==============================================================================
# When "true", the Surveyor agent gets 5 additional Class B tools:
# execute_handler_tool, query_db_tool, sample_table_tool,
# screenshot_preview_tool, read_browser_state_tool. Defaults off.
# SURVEYOR_RUNTIME_PROBES_ENABLED="false"

# Override the runtime worker base URL for diagnostic probes (defaults
# to the production p1.exepad.com). Set during local dev / staging.
# EXEPAD_RUNTIME_BASE="https://p1.exepad.com"

# Required when SURVEYOR_RUNTIME_PROBES_ENABLED=true. Provisioned via
# GCP Secret Manager and surfaced to Cloud Run via --set-secrets.
# Same value must be installed on the runtime worker via
# `wrangler secret put PLATFORM_DIAGNOSTIC_SECRET --env production`.
# PLATFORM_DIAGNOSTIC_SECRET="..."
