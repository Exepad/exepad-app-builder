    },
    {
      "id": "img_width_non_numeric",
      "input_path": "examples/img_width_non_numeric.html",
      "expected_tsx_contains": ["width=\"100%\""]
    },
    {
      "id": "img_with_class_preserved",
      "input_path": "examples/img_with_class_preserved.html",
