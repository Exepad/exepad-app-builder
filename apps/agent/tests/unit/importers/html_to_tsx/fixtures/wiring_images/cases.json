        "src=\"__ASSET_IMG:assets/imports/abc.webp__\"",
        "vendor=\"design_import\"",
        "keywords=\"hero shot\""
      ],
      "expected_tsx_absent": [
        "data-asset-relpath="
      ]
    },
    {
      "id": "img_data_alt_precedence",
      "input_path": "examples/img_data_alt_precedence.html",
      "expected_tsx_contains": [
        "<ExepadImage",
        "keywords=\"Portrait of a friendly middle-aged farmer in a straw hat\"",
        "width={200}",
        "height={200}"
      ],
      "expected_tsx_absent": [
        "keywords=\"Farmer John\""
      ]
    },
    {
      "id": "img_no_alt_warning",
      "input_path": "examples/img_no_alt_warning.html",
      "expected_tsx_contains": [
        "keywords=\"placeholder image\""
      ],
      "expected_warnings_contains": ["no alt text"]
    },
    {
      "id": "picture_collapse",
      "input_path": "examples/picture_collapse.html",
      "expected_tsx_contains": [
