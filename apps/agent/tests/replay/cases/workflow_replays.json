{
  "cases": [
    {
      "id": "workflow_creation_success_minimal_webapp",
      "kind": "workflow",
      "description": "A minimal successful creation replay should pass SSE and schema validation together.",
      "tags": ["smoke", "nightly"],
      "input": {
        "events": [
          {
            "type": "progress",
            "action": "creation_mode_starting",
            "message": "Starting build",
            "timestamp": 1
          },
          {
            "type": "progress",
            "action": "design_system",
            "message": "Generating design system",
            "timestamp": 2
          },
          {
            "type": "chat_message",
            "message": "Created your landing page.",
            "timestamp": 3
          },
          {
            "type": "app_config_updated",
            "message": "App config updated",
            "timestamp": 4
          },
          {
            "type": "progress",
            "action": "app_building_finished",
            "message": "Finished build",
            "timestamp": 5
          }
        ],
        "app_config_fixture": "tests/e2e/fixtures/app_configs/minimal_webapp.json"
      },
      "expect": {
        "report_passed": true,
        "required_passed_checks": [
          "workflow_lifecycle",
          "app_config_schema",
          "no_errors"
        ],
        "page_count_min": 1
      }
    },
    {
      "id": "workflow_edit_success_schema_still_valid",
      "kind": "workflow",
      "description": "A reduced edit replay should still validate the captured config and user-visible SSE flow.",
      "tags": ["nightly"],
      "input": {
        "events": [
          {
            "type": "progress",
            "action": "creation_mode_starting",
            "message": "Starting edit",
            "timestamp": 1
          },
          {
            "type": "chat_message",
            "message": "Updated the hero section.",
            "timestamp": 2
          },
          {
            "type": "app_config_updated",
            "message": "App config updated",
            "timestamp": 3
          },
          {
            "type": "progress",
            "action": "app_building_finished",
            "message": "Finished edit",
            "timestamp": 4
          }
        ],
        "app_config_fixture": "tests/e2e/fixtures/app_configs/minimal_webapp.json"
      },
      "expect": {
        "report_passed": true,
        "required_passed_checks": [
          "app_config_schema",
          "has_chat_response"
        ],
        "page_count_min": 1
      }
    },
    {
      "id": "workflow_failure_error_event_detected",
      "kind": "workflow",
      "description": "Failure replays should be easy to classify from deterministic SSE checks.",
      "tags": ["smoke", "nightly"],
      "input": {
        "events": [
          {
            "type": "progress",
            "action": "creation_mode_starting",
            "message": "Starting build",
            "timestamp": 1
          },
          {
            "type": "error",
            "action": "error",
            "message": "Semantic validation failed",
            "timestamp": 2
          }
        ]
      },
      "expect": {
        "report_passed": false,
        "required_failed_checks": [
          "no_errors",
          "workflow_lifecycle",
          "has_chat_response",
          "app_config_updated"
        ]
      }
    }
  ]
}
