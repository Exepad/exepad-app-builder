{
  "name": "@exepad/sdk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./core": {
      "types": "./types/core.d.ts",
      "default": "./src/entries/core.ts"
    },
    "./charts": {
      "types": "./types/charts.d.ts",
      "default": "./src/entries/charts.ts"
    },
    "./motion": {
      "types": "./types/motion.d.ts",
      "default": "./src/entries/motion.ts"
    },
    "./forms": {
      "types": "./types/forms.d.ts",
      "default": "./src/entries/forms.ts"
    },
    "./overlays": {
      "types": "./types/overlays.d.ts",
      "default": "./src/entries/overlays.ts"
    },
    "./icons": {
      "types": "./types/icons.d.ts",
      "default": "./src/entries/icons.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "tsc -b && vite build && pnpm run build:sdk:split",
    "build:sdk:split": "node build-split.mjs",
    "build:eject": "node build-eject.mjs",
    "check:split": "node scripts/check-split-chunks.mjs",
    "postbuild": "node scripts/generate-manifest.js && npx tsx scripts/generate-agent-docs.ts && node scripts/check-split-chunks.mjs && npx tsx scripts/sync-agent-gate.ts",
    "manifest": "node scripts/generate-manifest.js",
    "lint": "eslint .",
    "clean": "rm -rf dist",
    "generate:agent-docs": "npx tsx scripts/generate-agent-docs.ts",
    "sync:agent-gate": "npx tsx scripts/sync-agent-gate.ts",
    "check:agent-gate": "npx tsx scripts/sync-agent-gate.ts --check"
  },
  "dependencies": {
    "@exepad/ui-core": "workspace:*",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.11",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.13",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.23.26",
    "input-otp": "^1.4.2",
    "lodash-es": "^4.18.0",
    "lucide-react": "^0.562.0",
    "react": "^18.3.1",
    "react-day-picker": "^9.13.0",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.81.0",
    "react-resizable-panels": "^4.0.15",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/cli": "^4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.5.2",
    "happy-dom": "^20.8.9",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "terser": "^5.46.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^7.2.4",
    "vitest": "^4.0.18"
  },
  "license": "AGPL-3.0-only"
}
