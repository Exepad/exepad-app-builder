{
  "name": "@exepad/schemas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./validator": "./src/validator.ts"
  },
  "scripts": {
    "generate": "npx ts-json-schema-generator@2.4.0 --path '../../apps/runtime/client/src/app_runtime/interfaces/apps/webapp.ts' --type 'WebAppProps' --tsconfig './tsconfig.schema-gen.json' --no-type-check --out ./data/full_schema_model/full_schema.json",
    "validate:examples": "python3 scripts/py/validate_examples.py",
    "validate:examples:public": "python3 scripts/py/validate_public_examples.py",
    "test": "vitest run"
  },
  "dependencies": {
    "ajv": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "ts-json-schema-generator": "^2.4.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  },
  "license": "AGPL-3.0-only"
}
