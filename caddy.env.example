# caddy.env — Caddy-only environment for the DNS-01 sidecar
# (docker-compose.ondemand-dns.yml). Copy to caddy.env and fill in:
#
#   cp caddy.env.example caddy.env
#
# Kept OUT of the studio's environment so the domain-controlling API token never
# reaches the app container — Caddy alone reads it. Do NOT commit caddy.env
# (it's gitignored).

# Your DNS provider. Must be one of the SINGLE-API-TOKEN providers compiled into
# Dockerfile.caddy-dns:
#   cloudflare | digitalocean | gandi | hetzner | linode | vultr | duckdns | desec
EXEPAD_DNS_PROVIDER=cloudflare

# An API token scoped to edit DNS TXT records in your domain's zone. For
# Cloudflare: a token with Zone:DNS:Edit on the relevant zone. Treat as a secret.
EXEPAD_DNS_TOKEN=replace-with-your-dns-api-token
